{
  "printWidth": 140,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "auto",
  "overrides": [
    {
      "files": "**/*.md",
      "options": {
        "proseWrap": "always"
      }
    },
    {
      "files": "src/**/*.html",
      "options": {
        "bracketSameLine": true,
        "singleAttributePerLine": true
      }
    }
  ]
}
